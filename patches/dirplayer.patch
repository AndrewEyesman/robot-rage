+// Diagnostic: dump how dirplayer reads a movie's score.
+//   RR_DCR=/path/movie.dcr RR_FRAME=5 RR_CHANNELS=8-15 cargo test --test rr_score -- --nocapture
+
+use vm_rust::director::file::read_director_file_bytes;
+use vm_rust::player::score::Score;
+
+#[test]
+fn dump_score() {
+    let Ok(path) = std::env::var("RR_DCR") else { return };
+    let frame: u32 = std::env::var("RR_FRAME").ok().and_then(|f| f.parse().ok()).unwrap_or(1);
+    let (lo, hi) = std::env::var("RR_CHANNELS")
+        .ok()
+        .and_then(|r| r.split_once('-').map(|(a, b)| (a.parse().unwrap(), b.parse().unwrap())))
+        .unwrap_or((1u32, 20u32));
+
+    let bytes = std::fs::read(&path).expect("read movie");
+    let file = read_director_file_bytes(&bytes, "movie.dcr", "http://local/").expect("parse movie");
+    let chunk = file.score.as_ref().expect("score chunk");
+    let mut score = Score::empty();
+    score.load_from_score_chunk(chunk, file.version);
+
+    println!("frame_count={:?} spans={}", score.frame_count, score.sprite_spans.len());
+    for span in &score.sprite_spans {
+        if (lo..=hi).contains(&span.channel_number) || span.channel_number == 0 {
+            println!(
+                "span ch={} frames={}-{} scripts={:?}",
+                span.channel_number,
+                span.start_frame,
+                span.end_frame,
+                span.scripts.iter().map(|s| (s.cast_lib, s.cast_member)).collect::<Vec<_>>()
+            );
+        }
+    }
+    for (frame_idx, channel, data) in &score.channel_initialization_data {
+        if *frame_idx + 1 == frame && (lo as u16..=hi as u16).contains(channel) {
+            println!(
+                "frame {} ch {}: member {}/{} pos {},{} size {}x{} type {} ink {} blend {} trails {} stretch {} color_flag {}",
+                frame, channel, data.cast_lib, data.cast_member, data.pos_x, data.pos_y, data.width, data.height, data.sprite_type,
+                data.ink, data.blend, data.trails, data.stretch, data.color_flag
+            );
+        }
+    }
+}
+
+// Dump each Shockwave 3D member's raw 3DPR info block and how it parses.
+//   RR_DCR=/path/movie.dcr cargo test --test rr_score dump_w3d_info -- --nocapture
+#[test]
+fn dump_w3d_info() {
+    let Ok(path) = std::env::var("RR_DCR") else { return };
+    let bytes = std::fs::read(&path).expect("read movie");
+    let file = read_director_file_bytes(&bytes, "movie.dcr", "http://local/").expect("parse movie");
+    for cast in &file.casts {
+        let mut nums: Vec<_> = cast.members.keys().copied().collect();
+        nums.sort();
+        for num in nums {
+            let raw = &cast.members[&num].chunk.specific_data_raw;
+            if !raw.windows(4).any(|w| w == b"3DPR") {
+                continue;
+            }
+            let hex: Vec<String> = raw.iter().take(128).map(|b| format!("{:02x}", b)).collect();
+            println!("cast {} member {} len {}", cast.id, num, raw.len());
+            for row in hex.chunks(16) {
+                println!("  {}", row.join(" "));
+            }
+            println!("  parsed: {:?}", vm_rust::director::enums::Shockwave3dInfo::from(raw));
+        }
+    }
+}
