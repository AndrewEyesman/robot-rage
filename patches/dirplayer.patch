index d447a516..8de12eda 100644
--- a/vm-rust/src/lib.rs
+++ b/vm-rust/src/lib.rs
@@ -2540,3 +2540,68 @@ pub fn start() {
     }
     init_player();
 }
+
+/// Debug: sweep sprite `probe` over a grid and test `probe intersects t` for each
+/// target, at every `angle_step` degrees. Returns JSON
+/// `{"xs":[..],"ys":[..],"angles":[..],"hits":{"<target>":["<0/1 per x>" per y per angle]}}`.
+/// The probe's loc and rotation are restored afterwards. Used by the arena
+/// collision sweep (`scripts/collision-sweep.mjs`).
+#[wasm_bindgen]
+pub fn rr_intersect_sweep(
+    probe: i16,
+    targets: Vec<i16>,
+    left: i32,
+    top: i32,
+    right: i32,
+    bottom: i32,
+    step: i32,
+    angle_step: f64,
+) -> String {
+    use player::bytecode::sprite_compare::sprites_intersect;
+    reserve_player_mut(|player| {
+        let saved = {
+            let s = player.movie.score.get_sprite_mut(probe);
+            (s.loc_h, s.loc_v, s.rotation)
+        };
+        let xs: Vec<i32> = (left..right).step_by(step.max(1) as usize).collect();
+        let ys: Vec<i32> = (top..bottom).step_by(step.max(1) as usize).collect();
+        let mut angles = vec![];
+        let mut a = 0.0;
+        while a < 360.0 {
+            angles.push(a);
+            a += angle_step.max(1.0);
+        }
+        let mut hits: Vec<(i16, Vec<String>)> = targets.iter().map(|t| (*t, vec![])).collect();
+        for &angle in &angles {
+            for &y in &ys {
+                let mut rows: Vec<String> = targets.iter().map(|_| String::with_capacity(xs.len())).collect();
+                for &x in &xs {
+                    {
+                        let s = player.movie.score.get_sprite_mut(probe);
+                        s.loc_h = x;
+                        s.loc_v = y;
+                        s.rotation = angle;
+                    }
+                    for (i, t) in targets.iter().enumerate() {
+                        rows[i].push(if sprites_intersect(player, probe, *t) { '1' } else { '0' });
+                    }
+                }
+                for (i, row) in rows.into_iter().enumerate() {
+                    hits[i].1.push(row);
+                }
+            }
+        }
+        {
+            let s = player.movie.score.get_sprite_mut(probe);
+            (s.loc_h, s.loc_v, s.rotation) = saved;
+        }
+        let hits_json: Vec<String> = hits
+            .iter()
+            .map(|(t, rows)| format!("\"{}\":[{}]", t, rows.iter().map(|r| format!("\"{}\"", r)).collect::<Vec<_>>().join(",")))
+            .collect();
+        format!(
+            "{{\"xs\":{:?},\"ys\":{:?},\"angles\":{:?},\"hits\":{{{}}}}}",
+            xs, ys, angles, hits_json.join(",")
+        )
+    })
+}
