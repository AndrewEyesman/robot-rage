+
+#[cfg(test)]
+mod matte_tests {
+    use super::*;
+    use crate::player::bitmap::palette_map::PaletteMap;
+
+    /// A 32-bit image with alpha mattes by its alpha, whatever colour sits under
+    /// the transparent pixels. Robot Rage's arena collision maps have black,
+    /// fully transparent floor; keying out white made that floor a wall.
+    #[test]
+    fn alpha_image_mattes_by_alpha() {
+        let mut bmp = Bitmap::new(4, 1, 32, 32, 8, PaletteRef::BuiltIn(BuiltInPalette::SystemWin));
+        bmp.use_alpha = true;
+        let pixels: [[u8; 4]; 4] = [[0, 0, 0, 0], [0, 0, 0, 255], [255, 255, 255, 0], [255, 255, 255, 255]];
+        for (i, p) in pixels.iter().enumerate() {
+            bmp.data[i * 4..i * 4 + 4].copy_from_slice(p);
+        }
+        bmp.create_matte(&PaletteMap::new());
+        let matte = bmp.matte.as_ref().unwrap();
+        let bits: Vec<bool> = (0..4).map(|x| matte.get_bit(x, 0)).collect();
+        assert_eq!(bits, vec![false, true, false, true]);
+    }
+}
