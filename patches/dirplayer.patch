+    fn mus_float_is_big_endian_double() {
+        let message = MultiuserMessage {
+            error_code: 0,
+            recipients: vec![],
+            sender_id: String::new(),
+            subject: String::new(),
+            content: StaticDatum::Float(1.5),
+            time_stamp: 0,
+        };
+        let bytes = message.to_bytes(None);
+        // frame header 6, error 4, time 4, subject 4, sender 4, recipients 4
+        let content = &bytes[26..];
+        assert_eq!(&content[..2], &[0, 6]);
+        assert_eq!(&content[2..10], &1.5f64.to_be_bytes());
