+/// Director (Mac) key code for a browser key. Navigation keys are matched by
+/// name: their JS key codes (33-36, 46) equal the char codes of "!", "\"", "#",
+/// "$" and ".", which the editable-field input path sends as key codes.
+fn director_key_code(key: &str, code: u16) -> u16 {
+    match key {
+        "PageUp" => 116,
+        "PageDown" => 121,
+        "End" => 119,
+        "Home" => 115,
+        "Delete" => 117,
+        _ => *keyboard_map::get_keyboard_key_map_js_to_sw().get(&code).unwrap_or(&code),
+    }
+}
