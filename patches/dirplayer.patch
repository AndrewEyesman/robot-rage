+// Decode one bitmap member and summarise its alpha channel.
+//   RR_DCR=/path/movie.dcr RR_MEMBER=140 cargo test --test rr_score dump_bitmap_alpha -- --nocapture
+#[test]
+fn dump_bitmap_alpha() {
+    use vm_rust::director::chunks::cast_member::CastMemberSpecificData;
+    let (Ok(path), Ok(member)) = (std::env::var("RR_DCR"), std::env::var("RR_MEMBER")) else { return };
+    let member: u32 = member.parse().unwrap();
+    let bytes = std::fs::read(&path).expect("read movie");
+    let file = read_director_file_bytes(&bytes, "movie.dcr", "http://local/").expect("parse movie");
+    for cast in &file.casts {
+        let Some(def) = cast.members.get(&member) else { continue };
+        let CastMemberSpecificData::Bitmap(info) = &def.chunk.specific_data else { continue };
+        println!("cast {} member {}: {}x{} depth {} use_alpha {}", cast.id, member, info.width, info.height, info.bit_depth, info.use_alpha);
+        for (i, c) in def.children.iter().enumerate() {
+            let kind = match c {
+                Some(vm_rust::director::chunks::Chunk::Bitmap(b)) => format!("BITD {} bytes v{} head {:02x?}", b.data.len(), b.version, &b.data[..b.data.len().min(8)]),
+                Some(vm_rust::director::chunks::Chunk::Raw(d)) => format!("raw {} bytes", d.len()),
+                Some(_) => "other".into(),
+                None => "none".into(),
+            };
+            println!("  child {}: {}", i, kind);
+        }
+        let Some(bitd) = def.children.iter().find_map(|c| c.as_ref().and_then(|c| c.as_bitmap())) else { continue };
+        if let Ok(out) = std::env::var("RR_BITD_OUT") {
+            std::fs::write(&out, &bitd.data).expect("write BITD");
+        }
+        let bmp = vm_rust::player::bitmap::bitmap::decompress_bitmap(&bitd.data, info, 1, bitd.version).expect("decode");
+        println!("  decoded {}x{} bit_depth {} data {} bytes", bmp.width, bmp.height, bmp.bit_depth, bmp.data.len());
+        if bmp.bit_depth == 32 {
+            let mut hist = [0usize; 4];
+            for px in bmp.data.chunks(4) {
+                let a = px[3];
+                hist[if a == 0 { 0 } else if a < 128 { 1 } else if a < 255 { 2 } else { 3 }] += 1;
+            }
+            println!("  byte3 histogram 0/<128/<255/255: {:?}", hist);
+            let mut hist0 = [0usize; 4];
+            for px in bmp.data.chunks(4) {
+                let a = px[0];
+                hist0[if a == 0 { 0 } else if a < 128 { 1 } else if a < 255 { 2 } else { 3 }] += 1;
+            }
+            println!("  byte0 histogram 0/<128/<255/255: {:?}", hist0);
+            let w = bmp.width as usize;
+            let at = |x: usize, y: usize| &bmp.data[(y * w + x) * 4..(y * w + x) * 4 + 4];
+            println!("  px(5,5)={:?} px(200,300)={:?}", at(5, 5), at(200, 300));
+        }
+    }
+}
