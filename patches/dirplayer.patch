+// Write bitmap members as PNGs: the image (with alpha), its alpha channel, and the
+// matte dirplayer builds for matte ink (white = opaque/collides).
+//   RR_DCR=/path/movie.dcr RR_MEMBERS=197,198 RR_OUT=/tmp/dir cargo test --test rr_score dump_bitmap_png -- --nocapture
+#[test]
+fn dump_bitmap_png() {
+    use vm_rust::director::chunks::cast_member::CastMemberSpecificData;
+    use vm_rust::player::bitmap::palette_map::PaletteMap;
+    let (Ok(path), Ok(members), Ok(out)) =
+        (std::env::var("RR_DCR"), std::env::var("RR_MEMBERS"), std::env::var("RR_OUT")) else { return };
+    let bytes = std::fs::read(&path).expect("read movie");
+    let file = read_director_file_bytes(&bytes, "movie.dcr", "http://local/").expect("parse movie");
+    let palettes = PaletteMap::new();
+    for member in members.split(',').map(|m| m.trim().parse::<u32>().unwrap()) {
+        for cast in &file.casts {
+            let Some(def) = cast.members.get(&member) else { continue };
+            let CastMemberSpecificData::Bitmap(info) = &def.chunk.specific_data else { continue };
+            let Some(bitd) = def.children.iter().find_map(|c| c.as_ref().and_then(|c| c.as_bitmap())) else { continue };
+            let mut bmp = vm_rust::player::bitmap::bitmap::decompress_bitmap(&bitd.data, info, 1, bitd.version).expect("decode");
+            bmp.use_alpha = info.use_alpha;
+            let (w, h) = (bmp.width as u32, bmp.height as u32);
+            let mut rgba = image::RgbaImage::new(w, h);
+            let mut alpha = image::GrayImage::new(w, h);
+            for y in 0..h {
+                for x in 0..w {
+                    let (r, g, b, a) = bmp.get_pixel_color_with_alpha(&palettes, x as u16, y as u16);
+                    rgba.put_pixel(x, y, image::Rgba([r, g, b, a]));
+                    alpha.put_pixel(x, y, image::Luma([a]));
+                }
+            }
+            bmp.create_matte(&palettes);
+            let matte = bmp.matte.as_ref().unwrap();
+            let mut m = image::GrayImage::new(w, h);
+            let mut opaque = 0usize;
+            for y in 0..h {
+                for x in 0..w {
+                    let bit = matte.get_bit(x as u16, y as u16);
+                    opaque += bit as usize;
+                    m.put_pixel(x, y, image::Luma([if bit { 255 } else { 0 }]));
+                }
+            }
+            let a_opaque = alpha.pixels().filter(|p| p.0[0] >= 128).count();
+            println!(
+                "cast {} member {}: {}x{} depth {} use_alpha {} | matte opaque {:.1}% | alpha>=128 {:.1}%",
+                cast.id, member, w, h, info.bit_depth, info.use_alpha,
+                100.0 * opaque as f64 / (w * h) as f64, 100.0 * a_opaque as f64 / (w * h) as f64
+            );
+            rgba.save(format!("{}/m{}-image.png", out, member)).unwrap();
+            alpha.save(format!("{}/m{}-alpha.png", out, member)).unwrap();
+            m.save(format!("{}/m{}-matte.png", out, member)).unwrap();
+        }
+    }
+}
