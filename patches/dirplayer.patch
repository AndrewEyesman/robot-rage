     pub fn create_matte(&mut self, palettes: &PaletteMap) {
+        // A 32-bit image with an alpha channel mattes by its alpha (11.5
+        // Scripting Dictionary, createMatte: "built from the image's alpha
+        // layer"; its alphaThreshold argument defaults to 0). Robot Rage's arena
+        // collision maps are such images: walls are opaque, open floor is
+        // transparent, and the colour under the transparent pixels is a mix of
+        // black and white. Keying out the white background instead made most of
+        // two maps solid, so the robot hit walls that aren't there.
+        if self.bit_depth == 32 && self.use_alpha {
+            let mut matte = BitmapMask::new(self.width, self.height, false);
+            for y in 0..self.height {
+                for x in 0..self.width {
+                    let (_, _, _, a) = self.get_pixel_color_with_alpha(palettes, x, y);
+                    matte.set_bit(x, y, a > 0);
+                }
+            }
+            self.matte = Some(Arc::new(matte));
+            return;
+        }
         let bg_color = &self.get_bg_color_ref();
         let mut mask = self.get_mask(palettes, bg_color);
         let mut outside_pixels = vec![];
