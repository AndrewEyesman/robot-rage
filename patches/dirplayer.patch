+/// Byte index of the caret nearest to (local_x, local_y) in unwrapped text drawn
+/// natively (Canvas2D) in `font_name` at `font_size`.
+fn native_caret_index(
+    text: &str,
+    font_name: &str,
+    font_size: u16,
+    fixed_line_space: u16,
+    local_x: i32,
+    local_y: i32,
+) -> i32 {
+    use crate::player::handlers::datum_handlers::cast_member::font::FontMemberHandlers;
+    let font_name = if font_name.is_empty() { "Arial" } else { font_name };
+    let font_size = if font_size > 0 { font_size } else { 12 };
+    let line_h = if fixed_line_space > 0 {
+        fixed_line_space as i32
+    } else {
+        (font_size as i32 * 6 + 4) / 5
+    };
+    let width_of = |s: &str| -> i32 {
+        if s.is_empty() {
+            return 0;
+        }
+        FontMemberHandlers::measure_text_native(s, font_name, font_size, false, 0, 0, 0, 0).0 as i32
+    };
+
+    // Pick the line under the click, then the nearest character boundary on it.
+    let line_index = (local_y.max(0) / line_h.max(1)) as usize;
+    let mut line_start = 0;
+    let mut line = text;
+    for (i, l) in text.split(|c| c == '\r' || c == '\n').enumerate() {
+        line = l;
+        if i == line_index {
+            break;
+        }
+        line_start += l.len() + 1;
+    }
+    line_start = line_start.min(text.len());
+
+    let mut prev_byte = 0;
+    let mut prev_w = 0;
+    for (byte, ch) in line.char_indices() {
+        let next_byte = byte + ch.len_utf8();
+        let next_w = width_of(&line[..next_byte]);
+        if local_x < (prev_w + next_w) / 2 {
+            return (line_start + prev_byte) as i32;
+        }
+        prev_byte = next_byte;
+        prev_w = next_w;
+    }
+    (line_start + line.len()) as i32
+}
