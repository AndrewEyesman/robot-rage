+    #[test]
+    fn mus_message_round_trips_lingo_values() {
+        let content = StaticDatum::PropList(vec![
+            (StaticDatum::Symbol("pos".into()), StaticDatum::IntPoint(-12, 340)),
+            (StaticDatum::Symbol("box".into()), StaticDatum::IntRect(1, 2, 300, 400)),
+            (StaticDatum::Symbol("speed".into()), StaticDatum::Float(-3.25)),
+            (StaticDatum::Symbol("tiny".into()), StaticDatum::Float(1e-300)),
+            (StaticDatum::String("name".into()), StaticDatum::String("odd".into())),
+            (
+                StaticDatum::Symbol("list".into()),
+                StaticDatum::List(vec![
+                    StaticDatum::Int(i32::MIN),
+                    StaticDatum::Void,
+                    StaticDatum::Symbol("ab".into()),
+                    StaticDatum::Media(vec![1, 2, 3]),
+                    StaticDatum::List(vec![]),
+                ]),
+            ),
+        ]);
+        let message = MultiuserMessage {
+            error_code: -7,
+            recipients: vec!["peer1".into(), "@All".into()],
+            sender_id: "me".into(),
+            subject: "Move".into(),
+            content: content.clone(),
+            time_stamp: 1234,
+        };
+        let bytes = message.to_bytes(None);
+        let mut reader = BinaryReader::from_u8(&bytes);
+        let read = reader.read_mus_message(None).unwrap();
+        assert_eq!(read.content, content);
+        assert_eq!(read.subject, "Move");
+        assert_eq!(read.sender_id, "me");
+        assert_eq!(read.recipients, vec!["peer1".to_string(), "@All".to_string()]);
+        assert_eq!(read.error_code, -7);
+        assert_eq!(read.time_stamp, 1234);
+    }
+
