+                                error_code: 0,
+                                recipients: vec!["*".to_string()],
+                                sender_id: "System".to_string(),
+                                subject: "String".to_string(),
+                                content: StaticDatum::String(message_str),
+                                time_stamp: 0,
+                            });
+                        }
+                        MultiuserConnectionMode::Binary => {
+                            instance.receive_binary_data(&message_bytes);
